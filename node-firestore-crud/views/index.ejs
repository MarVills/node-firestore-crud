<!DOCTYPE html>
<html>
<head>
  <title>Users CRUD</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <h1>Users List</h1>
  <a href="/create">Create New User</a>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(user => { %>
        <tr>
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td>
            <a href="/edit/<%= user.id %>">Edit</a>
            <a href="/delete/<%= user.id %>" onclick="return confirm('Delete this user?')">Delete</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
